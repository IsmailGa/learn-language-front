# Production Dockerfile для Vue (build + nginx)
# Итоговый образ: ~25MB (alpine nginx)

# ── Этап 1: Build ─────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --frozen-lockfile

COPY . .
# VITE_API_URL будет передан через build args или .env.prod
ARG VITE_API_URL=/
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Этап 2: Production nginx ───────────────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Удаляем default конфиг nginx
RUN rm /etc/nginx/conf.d/default.conf

# Копируем собранный SPA
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx конфиг (монтируется через volume в prod, или копируем здесь)
COPY nginx.conf /etc/nginx/conf.d/app.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
